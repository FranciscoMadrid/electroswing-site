---
import '@/styles/global.css'
import siteConfig from "../config/site.json"
import Footer from './components/functional components/Footer'
import Image from 'astro/components/Image.astro'
import NavbarContainer from '@/layout/components/functional components/navbar/NavbarContainer'

export interface Props {
  title?: string,
  meta_title?:string,
  favicon?: string,
	className?: string,
	style?: string
}

const {
  title = siteConfig.site.title, 
  favicon = siteConfig.site.favicon_image, 
	className,
	style,
  meta_title} = Astro.props

	const pathname = Astro.url.pathname;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={favicon ?? ''} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body 
		style={style}
		class={`bg-background font-modernoir min-h-screen flex flex-col scroll-smooth ${className}`}>
		<NavbarContainer client:load/>
		<main class="grow">
      <slot/>
		</main>
		<div class="flex flex-col pt-10 w-full">
			<div 
				class="w-full h-50 md:h-[30vh]"
				style={
					'background-image: url("/images/footer_bg.svg");'
				}
			/>
			<Footer/>
		</div>
	</body>
</html>
